<Project Sdk="Microsoft.NET.Sdk">

  <!--
    采集/编码探针：验证两件现场出问题的事
      1. GDI 能不能一次抓住"整个虚拟桌面"（主屏 + 虚拟外屏 一块画布）——画面会不会是黑的；
      2. ffmpeg 编码器在画布尺寸（例如 4480x1440）下能不能启动 —— 我们写死的 -level 4.0 会不会把它卡死。
    只读屏幕、只往临时目录写 png，不改系统任何东西。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CaptureProbe</AssemblyName>
    <RootNamespace>CaptureProbe</RootNamespace>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Agent\Agent.Common\Agent.Common.csproj" />
    <ProjectReference Include="..\..\Agent\Agent.Worker\Agent.Worker.csproj" />
  </ItemGroup>

</Project>
