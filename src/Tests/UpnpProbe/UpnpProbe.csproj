<Project Sdk="Microsoft.NET.Sdk">
  <!-- 用我们自己代码里的 UpnpPortMapper 测这台机器的路由器支不支持自动映射。
       结果决定"让主控端当直连服务端"这条路走不走得通。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UpnpProbe</AssemblyName>
    <RootNamespace>UpnpProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Agent\Agent.Common\Agent.Common.csproj" />
  </ItemGroup>
</Project>
