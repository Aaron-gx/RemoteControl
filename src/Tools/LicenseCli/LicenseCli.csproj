<Project Sdk="Microsoft.NET.Sdk">
  <!-- 命令行签发激活码：给"换/加中继服务器"这种部署场景用（GUI 上位机仍是日常工具）。
       私钥默认取 E:\RemoteControl\license\private.pem，绝不外发。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LicenseCli</AssemblyName>
    <RootNamespace>LicenseCli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Agent\Agent.Common\Agent.Common.csproj" />
  </ItemGroup>
</Project>
