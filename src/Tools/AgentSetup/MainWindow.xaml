<Window x:Class="AgentSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程控制 · 被控端安装" Height="580" Width="760"
        Background="#FFFFFFFF" FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- 统一配色：只用这一套，避免"颜色配不齐" -->
        <SolidColorBrush x:Key="Ink" Color="#FF1F1F1F"/>
        <SolidColorBrush x:Key="Sub" Color="#FF6B6B6B"/>
        <SolidColorBrush x:Key="Accent" Color="#FF1E7BE4"/>
        <SolidColorBrush x:Key="Line" Color="#FFE6E6E6"/>
        <SolidColorBrush x:Key="Field" Color="#FFFBFBFB"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="Primary" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1668C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFBBD3F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="White" BorderBrush="#FFC8C8C8" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF2F2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF7F7F7"/>
                                <Setter Property="Foreground" Value="#FFB0B0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="#FFD5D5D5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,5,26,5"/>
        </Style>
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#FFEDEDED"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部品牌条（贯穿四步，颜色统一） -->
        <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="26,16">
            <StackPanel>
                <TextBlock Text="远程控制 · 被控端" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="安装后，主控端即可远程操作这台电脑"
                           Foreground="#FFD8E8FB" FontSize="12.5" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 内容区：四步切换 -->
        <Grid Grid.Row="1" Margin="26,20,26,0">

            <!-- 第 1 步：欢迎 -->
            <StackPanel x:Name="Step1" Visibility="Visible">
                <TextBlock Text="欢迎使用" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource SubText}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="点击「下一步」开始安装。安装过程约 1~2 分钟，全程不需要填写任何信息。"/>
                <Border Background="#FFF7FAFF" BorderBrush="#FFDCE9FA" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="安装程序会自动完成：" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource SubText}" Text="· 部署被控端程序并注册开机自启"/>
                        <TextBlock Style="{StaticResource SubText}" Text="· 建立独立远程会话（远程操作与本机使用互不干扰）"/>
                        <TextBlock Style="{StaticResource SubText}" Text="· 加入 Defender 排除项，避免被误杀"/>
                        <TextBlock Style="{StaticResource SubText}" Text="· 装完自动检查与服务器的连通性并显示结果"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 第 2 步：安装位置 -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock Text="选择安装位置" FontSize="17" FontWeight="SemiBold"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="DirBox"/>
                    <Button Grid.Column="1" x:Name="BrowseBtn" Content="浏览…" Style="{StaticResource Secondary}" Margin="10,0,0,0"/>
                </Grid>

                <Expander x:Name="Advanced" Header="高级设置（一般不用动）" Margin="0,18,0,0" Foreground="{StaticResource Sub}">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="服务器" Style="{StaticResource SubText}"/>
                        <TextBox x:Name="ServerBox" Margin="0,6,0,12"/>
                        <TextBlock Text="连接口令（已预置，留空即用内置）" Style="{StaticResource SubText}"/>
                        <TextBox x:Name="TokenBox" Margin="0,6,0,12"/>
                        <TextBlock Text="安装选项（默认：共享本机桌面 + 外屏；正常不用改）" Style="{StaticResource SubText}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox x:Name="MultiSessionBox" Content="独立会话模式"
                                      ToolTip="勾上＝旧方案：新建 RemoteWorker 用户 + RDP 会话，远程与本机各自一个桌面、互不干扰（代价：数据不共享、机器没人登录也能连）。不勾＝默认：远程操作的就是本机已登录用户的桌面 + 虚拟外屏，软件与数据跟本机是同一份。"/>
                            <CheckBox x:Name="AutoStartBox" Content="自动启动（登录时）"
                                      ToolTip="共享模式必须跑在已登录用户的会话里才有桌面，所以是登录时以管理员权限启动；勾掉则每次要手动启动被控端。"/>
                            <CheckBox x:Name="DefenderBox" Content="Defender 排除项"/>
                            <CheckBox x:Name="VddBox" Content="虚拟外屏"
                                      ToolTip="共享模式下的远程那块屏：作为一块扩展显示器挂在当前会话上，采集它、打开的软件会自动摆到它上面，窗口也能从物理屏拖过来。"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- 第 3 步：安装中 -->
            <Grid x:Name="Step3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="正在安装…" FontSize="17" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="1" Margin="0,14,0,12">
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource SubText}" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Grid.Row="2" Background="#FFFAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             BorderThickness="0" Background="Transparent" Foreground="#FF333333"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                             Padding="12,10" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>

            <!-- 第 4 步：完成 -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DoneGlyph" Text="✓" FontSize="22" FontWeight="Bold" Foreground="#FF2AA84A" Margin="0,0,10,0"/>
                    <TextBlock x:Name="DoneTitle" Text="安装完成" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="DoneText" Style="{StaticResource SubText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <Border x:Name="DoneBox" Background="#FFF7FAFF" BorderBrush="#FFDCE9FA" BorderThickness="1"
                        CornerRadius="4" Padding="14,12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="这台电脑的 AgentId（主控端按它连接）" Style="{StaticResource SubText}"/>
                        <TextBlock x:Name="AgentIdText" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="HostText" Style="{StaticResource SubText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="RunNowBox" Content="完成后自动启动被控端" IsChecked="True" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 底部按钮区 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,14" Margin="0,18,0,0">
            <Grid>
                <TextBlock x:Name="FooterText" Style="{StaticResource SubText}" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackBtn" Content="上一步" Style="{StaticResource Secondary}" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="NextBtn" Content="下一步" Style="{StaticResource Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
