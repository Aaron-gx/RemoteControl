<Window x:Class="LicenseKeygen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LicenseKeygen"
        Title="激活码生成器" Height="856" Width="980"
        Background="#FFE7EDF5" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#FF1F2328"/>
        <SolidColorBrush x:Key="Muted" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="Line" Color="#FFD5DEE9"/>
        <SolidColorBrush x:Key="LineSoft" Color="#FFE6ECF3"/>
        <SolidColorBrush x:Key="Accent" Color="#FF1A6FB5"/>
        <SolidColorBrush x:Key="Danger" Color="#FFB3261E"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#FFCFD4DA"/>

        <!-- 基础字体：统一 13px，只有卡片标题加粗，避免到处都是粗体 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 卡片：白底 + 细边 + 圆角，替代原来"裸控件堆在灰底上"的观感 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 输入控件：圆角 + 等高 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF6F7F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF5F8FB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEDF3F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF6F7F9"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF16639F"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF12548A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 次要强调：白底蓝边蓝字（用于「安装到服务器」这类主要但非首选的动作） -->
        <Style x:Key="AccentOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFEDF4FB"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFDDEAF7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFFBEEED"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFF6DEDC"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日期选择器：默认模板是"方框套方框"，跟卡片风格不搭，这里换成圆角单框 + 自绘图标。
             必须保留 PART_Root / PART_TextBox / PART_Button / PART_Popup 四个部件名，
             否则日历弹不出来（Calendar 由 DatePicker 自己塞进 PART_Popup）。 -->
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Focusable="True"
                                                   Background="Transparent" BorderThickness="0" Padding="8,0"
                                                   VerticalContentAlignment="Center"
                                                   FontFamily="Microsoft YaHei UI" FontSize="13">
                                    <DatePickerTextBox.Template>
                                        <ControlTemplate TargetType="DatePickerTextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}" Focusable="False"/>
                                        </ControlTemplate>
                                    </DatePickerTextBox.Template>
                                </DatePickerTextBox>
                                <Button x:Name="PART_Button" Grid.Column="1" Width="28" Focusable="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="0,6,6,0">
                                                <Path x:Name="Icon" Margin="7,0,7,0" VerticalAlignment="Center"
                                                      Stroke="#FF7C8B9B" StrokeThickness="1.3"
                                                      Data="M1,3 L13,3 L13,12 L1,12 Z M1,6 L13,6 M4,1.5 L4,4 M10,1.5 L10,4"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFEDF3F9"/>
                                                    <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=Bd}" StaysOpen="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF2F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 页签：现代扁平（选中=深色字+蓝色下划线） -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="16,9" Margin="0,0,2,0"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FFF2F6FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                                <TabPanel IsItemsHost="True" Margin="8,0,8,0"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,10,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 台账表格 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF8FAFD"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE6ECF3"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFE6ECF3"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFEDF2F8"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE8F0FE"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：标题与副标题一行横排（原大图标已去掉，省出竖向空间） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="激活码生成器 · 上位机" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="签发 / 管理激活码，并把结果同步到中继服务器" FontSize="12.5"
                       Foreground="{StaticResource Muted}" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- 中继服务器与令牌。令牌框直接粘贴服务器上的 RC_TOKEN 就行，默认明文可见；
             「读取令牌」从本机文件里读（不用记路径），勾「隐藏」才打码。 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="中继服务器" Style="{StaticResource FieldLabel}" Width="70"/>
                <TextBox Grid.Column="1" x:Name="ServerBox" Text="202.60.232.209:8080"/>
                <TextBlock Grid.Column="2" Text="令牌" Style="{StaticResource FieldLabel}" Margin="16,0,10,0"/>
                <!-- 令牌默认明文显示（粘进去就该看得见，才好核对是不是服务器上那一串）；
                     勾「隐藏」时换成打码框。两个控件占同一格，由代码同步内容、切换可见性 ——
                     WPF 的 PasswordBox 不能像 WinForms 那样随时改掩码字符。 -->
                <Grid Grid.Column="3">
                    <TextBox x:Name="TokenBox" Width="220" FontFamily="Consolas" FontSize="12"
                             ToolTip="把服务器上的 RC_TOKEN 粘进来即可；点「读取令牌」可从本机已有文件里读"/>
                    <PasswordBox x:Name="TokenPw" Width="220" PasswordChar="●" Visibility="Collapsed"
                                 ToolTip="令牌已打码；取消勾选「隐藏」可看原文"/>
                </Grid>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                    <CheckBox x:Name="HideTokenChk" Content="隐藏" Margin="0,0,12,0"/>
                    <Button x:Name="ReadTokenBtn" Content="读取令牌"/>
                    <Button x:Name="ClearTokenBtn" Content="清空" Margin="8,0,0,0"/>
                    <Button x:Name="RefreshStatusBtn" Content="刷新状态" Margin="8,0,0,0"/>
                    <Button x:Name="SyncRevokedBtn" Content="同步撤销名单" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabs">

            <!-- ============================================================ 签发 -->
            <TabItem Header="签发">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ① 厂商密钥 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="① 厂商密钥" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="私钥文件" Style="{StaticResource FieldLabel}" Width="70"/>
                                <TextBox Grid.Column="1" x:Name="KeyBox" Text="E:\RemoteControl\license\private.pem"/>
                                <Button Grid.Column="2" x:Name="PickKeyBtn" Content="选择…" Margin="8,0,0,0"/>
                                <Button Grid.Column="3" x:Name="GenKeyBtn" Content="生成新密钥对" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ② 签发参数 -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="② 签发参数" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="授权编号" Style="{StaticResource FieldLabel}" Width="106"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="LicBox" Margin="0,0,18,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="客户" Style="{StaticResource FieldLabel}" Width="106"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="SubBox" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="绑定部署ID" Style="{StaticResource FieldLabel}" Width="106"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SrvBox" Margin="0,0,18,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="绑定公网IP" Style="{StaticResource FieldLabel}" Width="106"/>
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="IpBox" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="生效日期（UTC）" Style="{StaticResource FieldLabel}" Width="106"/>
                                <DatePicker Grid.Row="2" Grid.Column="1" x:Name="NbfPicker" Margin="0,0,18,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="到期日期（UTC）" Style="{StaticResource FieldLabel}" Width="106"/>
                                <DatePicker Grid.Row="2" Grid.Column="3" x:Name="ExpPicker" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="最大主控端数" Style="{StaticResource FieldLabel}" Width="106"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="MaxViewBox" Text="2" Width="90"/>
                                    <TextBlock Text="0 = 不限制" Style="{StaticResource Hint}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="" Style="{StaticResource Hint}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ③ 激活码 -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="③ 激活码" Style="{StaticResource CardTitle}"/>
                            <TextBox Grid.Row="1" x:Name="CodeBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     MinHeight="104" Padding="8,6" FontFamily="Consolas" FontSize="12"/>
                            <!-- 安装入口：带令牌的 /admin 链接。只读框可以直接选中复制，也能点「复制链接」 -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="SignBtn" Content="生成激活码" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="InstallBtn" Content="安装到服务器" Style="{StaticResource AccentOutlineButton}" Margin="8,0,0,0"/>
                                    <Button x:Name="CopyBtn" Content="复制" Margin="8,0,0,0"/>
                                    <Button x:Name="SaveBtn" Content="保存到文件" Margin="8,0,0,0"/>
                                    <Button x:Name="LoadServerBtn" Content="读取服务器状态" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="安装入口" Style="{StaticResource FieldLabel}" Margin="18,0,8,0"/>
                                <TextBox Grid.Column="2" x:Name="InstallLinkBox" IsReadOnly="True" FontSize="12.5"
                                         FontFamily="Consolas" Background="#FFF7F9FC" Foreground="{StaticResource Muted}"
                                         ToolTip="带中继令牌的管理页链接：手动安装激活码时用，点右边「复制链接」可整条复制"/>
                                <Button Grid.Column="3" x:Name="CopyInstallLinkBtn" Content="复制链接" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- 令牌来路：写清楚"当前用的是哪来的令牌/为什么是空的"，
                                 省得盯着一个空框猜（隐藏字段看不出有没有值） -->
                            <TextBlock Grid.Row="3" x:Name="TokenHint" Style="{StaticResource Hint}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- ④ 验证激活码 -->
                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="④ 验证激活码" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="VerifyBox" FontFamily="Consolas" FontSize="12"/>
                                <Button Grid.Column="1" x:Name="VerifyBtn" Content="验证" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="VerifyResult" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== 激活码管理 -->
            <TabItem Header="管理">
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="CopyCodeBtn" Content="复制激活码"/>
                                <Button x:Name="DeleteBtn" Content="删除并失效" Style="{StaticResource DangerButton}" Margin="8,0,0,0"/>
                                <Button x:Name="RestoreBtn" Content="恢复" Margin="8,0,0,0"/>
                                <Button x:Name="ExportCsvBtn" Content="导出 CSV" Margin="8,0,0,0"/>
                                <CheckBox x:Name="ShowRevokedChk" Content="显示已删除" Margin="14,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="MgmtSummary" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="MgmtGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="授权编号" Binding="{Binding Lic}" Width="110" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="客户" Binding="{Binding Sub}" Width="95" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="绑定部署" Binding="{Binding Srv}" Width="155" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="有效期（UTC）" Binding="{Binding Validity}" Width="178" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="生成时间" Binding="{Binding CreatedText}" Width="132" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="状态" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="使用情况" Binding="{Binding InstalledText}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ========================================================== 使用说明 -->
            <TabItem Header="使用说明">
                <Border Style="{StaticResource Card}" Padding="4">
                    <!-- FlowDocumentScrollViewer 默认按"逻辑单位"滚动（一次跳一整段，滚轮很卡）；
                         外面套一层按像素滚动的 ScrollViewer，内层只负责排版。见 FastScrollViewer。 -->
                    <local:FastScrollViewer VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled"
                                            PanningMode="VerticalOnly" CanContentScroll="False">
                        <FlowDocumentScrollViewer x:Name="HelpViewer" IsToolBarVisible="False"
                                                  Background="Transparent" Padding="12,8"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled"/>
                    </local:FastScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#FFF0F5FB" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="14,8" Margin="-14,10,-14,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        </Border>
    </Grid>
</Window>
