<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 2026-10 进程合并：Worker 不再是独立 exe，而是被 Agent.Coordinator 引用的类库。
         原来的跨会话形态（Session 0 的 Coordinator 拉起 Session 1 的 Worker）已随多会话方案废弃；
         现在 WorkerContext 由 Coordinator 进程里的一条 STA 线程承载（见 Agent.Coordinator/WorkerHost.cs），
         与 Coordinator 之间用进程内 WorkerBridge 通信（取代 Named Pipe + 共享内存）。 -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Agent.Worker</AssemblyName>
    <RootNamespace>Agent.Worker</RootNamespace>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Common\Agent.Common.csproj" />
  </ItemGroup>

</Project>
