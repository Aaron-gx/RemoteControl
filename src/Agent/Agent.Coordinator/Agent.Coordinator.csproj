<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Agent.Coordinator</AssemblyName>
    <RootNamespace>Agent.Coordinator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- exe 的文件图标 + 托盘图标（托盘从嵌入资源读，见 TrayIcon） -->
    <ApplicationIcon>..\..\Assets\agent.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\agent.ico" LogicalName="Agent.Coordinator.agent.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Common\Agent.Common.csproj" />
    <!-- 2026-10 进程合并：采集引擎（原 Agent.Worker.exe）以类库形式并入本进程 -->
    <ProjectReference Include="..\Agent.Worker\Agent.Worker.csproj" />
  </ItemGroup>

</Project>
